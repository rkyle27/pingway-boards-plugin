<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <!-- The only package this plugin uses is Dalamud.NET.Sdk 15.0.0 (nuget.org, by goatcorp). It brings DalamudPackager and
       DotNet.ReproducibleBuilds itself (see packages.lock.json). No other NuGet packages. -->
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AssemblyName>PingwayBoards</AssemblyName>
    <RootNamespace>PingwayBoards</RootNamespace>
    <!-- The plugin manifest is PingwayBoards.json next to this file (DalamudPackager reads <AssemblyName>.json first) -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Board and poster backgrounds (made from the website's own Boards CSS), loaded from the plugin folder -->
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Plugin installer icon: DalamudPackager puts images\icon.png next to latest.zip -->
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Texts in 4 languages and the built-in sample posters (no network) -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="PingwayBoards.Lang.%(Filename).json" />
    <EmbeddedResource Include="Demo\demo-posters.json" LogicalName="PingwayBoards.Demo.demo-posters.json" />
  </ItemGroup>
</Project>
